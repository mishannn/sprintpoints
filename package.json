{
  "name": "planningpoker",
  "version": "3.0.0",
  "description": "Realtime planning poker app with a TypeScript/Hono/Drizzle backend on Cloudflare Workers.",
  "private": true,
  "workspaces": [
    "shared",
    "backend"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "backend:dev": "npm run dev -w backend",
    "backend:test": "npm run test -w backend",
    "backend:deploy": "npm run deploy -w backend",
    "backend:check": "npm run check -w backend",
    "prebuild": "npm run client:generate",
    "openapi:generate": "npm run openapi -w backend && npm run client:generate",
    "client:generate": "openapi-ts",
    "backend:openapi": "npm run openapi -w backend"
  },
  "keywords": [
    "planning-poker",
    "cloudflare-workers",
    "hono",
    "drizzle-orm",
    "durable-objects",
    "typescript",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mantine/core": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "tsx": "^4.23.15"
  }
}
