VITE_API_URL=http://localhost:8000/api

# Production Docker Compose
BASE_DOMAIN=example.com

POSTGRES_DB=planningpoker
POSTGRES_USER=planningpoker
POSTGRES_PASSWORD=change-this-database-password
DATABASE_SCHEMA=sprintpoints

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password

PLANNING_POKER_CORS_ORIGINS=https://sprintpoints.example.com

# Local backend development
DATABASE_URL=postgresql://planningpoker:change-this-database-password@localhost:5432/planningpoker

# NestJS backend cutover (optional)
NEST_DATABASE_SCHEMA=sprintpoints_nest
BACKEND_UPSTREAM=backend:8000
SOURCE_SCHEMA=sprintpoints
TARGET_SCHEMA=sprintpoints_nest
