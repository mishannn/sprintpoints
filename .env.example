# Frontend (Vite). Values prefixed with VITE_ are baked into the bundle at
# build time; in CI they come from repository variables, not from .env.
# Local development talks to the Worker started with `npm run backend:dev`.
VITE_API_URL=http://127.0.0.1:8787/api

# Optional base path for GitHub Pages project sites, e.g. /sprintpoints/
VITE_BASE_PATH=

# Target of the Vite dev proxy for /api (default http://127.0.0.1:8787)
VITE_DEV_API_URL=http://127.0.0.1:8787

# --------------------------------------------------------------------------
# Backend settings are not read from .env by the Worker.
#
# Local Worker:  backend/.dev.vars            (ADMIN_TOKEN=...)
# Deployed Worker: backend/wrangler.jsonc      (vars: CORS_ORIGINS)
#                  npx wrangler secret put ADMIN_TOKEN
#                  export CLOUDFLARE_API_TOKEN=...   # for deploys only
#
# The Python backend keeps its D1 schema in backend/src/app.py. The frontend
# keeps TypeScript API types and constants in shared/.
# --------------------------------------------------------------------------
