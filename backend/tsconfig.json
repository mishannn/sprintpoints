{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test",
    "drizzle.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
